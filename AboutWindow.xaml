<Window x:Class="Pickets.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Pickets"
        Width="520" Height="390"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FF17191D"
        Foreground="#FFF4F5F7"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2A2F37"/>
            <Setter Property="Foreground" Value="#FFF4F5F7"/>
            <Setter Property="BorderBrush" Value="#FF56606D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="54" Height="54" Margin="0,0,16,0" CornerRadius="12"
                    Background="#FF29394D" BorderBrush="#FF589BD5" BorderThickness="1">
                <TextBlock Text="P" FontSize="30" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Pickets" FontSize="27" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Foreground="#FFAFB7C2" FontSize="13"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,22,0,0" FontSize="15" TextWrapping="Wrap"
                   Text="A lightweight, offline desktop-icon organizer for Windows."/>

        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock Foreground="#FFD1D6DD" TextWrapping="Wrap" LineHeight="21"
                       Text="Pickets stores layouts locally, uses no accounts or telemetry, and never uploads your files. Diagnostic copies automatically redact your Windows user profile and username."/>
            <TextBlock Margin="0,16,0,0" Foreground="#FF8F99A6" TextWrapping="Wrap"
                       Text="Independent open-source software under the MIT License. Not affiliated with Stardock."/>
        </StackPanel>

        <DockPanel Grid.Row="3" LastChildFill="False">
            <WrapPanel DockPanel.Dock="Left">
                <Button Content="Copy diagnostics" Click="CopyDiagnostics_Click"/>
                <Button Content="Open data folder" Click="OpenDataFolder_Click"/>
                <Button Content="View on GitHub" Click="OpenGitHub_Click"/>
            </WrapPanel>
            <Button DockPanel.Dock="Right" Content="Close" IsDefault="True" Click="Close_Click"/>
        </DockPanel>
    </Grid>
</Window>
