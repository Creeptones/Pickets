<Window x:Class="Pickets.PicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pickets"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MinWidth="160" MinHeight="32"
        Title="Picket"
        UseLayoutRounding="True">
    <Window.Resources>
        <ContextMenu x:Key="ItemContextMenu">
            <MenuItem Header="Open" Click="ItemMenu_Open_Click"/>
            <MenuItem Header="Open file location" Click="ItemMenu_OpenLocation_Click"/>
            <MenuItem Header="Large icon (2x2)" Tag="LargeToggle" IsCheckable="True" Click="ItemMenu_ToggleLarge_Click"/>
            <Separator/>
            <MenuItem Header="Insert label above..." Click="ItemMenu_InsertLabelAbove_Click"/>
            <MenuItem Header="Remove from picket (restore icon)" Click="ItemMenu_Remove_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="LabelContextMenu">
            <MenuItem Header="Rename label..." Click="LabelMenu_Rename_Click"/>
            <MenuItem Header="Remove label" Click="LabelMenu_Remove_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="TitleContextMenu">
            <MenuItem Header="Rename picket..." Click="TitleMenu_Rename_Click"/>
            <MenuItem Header="Roll up / down" Click="TitleMenu_ToggleCollapse_Click"/>
            <MenuItem Header="Appearance">
                <MenuItem Header="Color" Tag="ColorMenu">
                <MenuItem Header="Porcelain" Tag="porcelain" IsCheckable="True" Click="TitleMenu_SetColor_Click">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Stroke="#A79F94" StrokeThickness="1"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#E5DFD5" Offset="0.5"/><GradientStop Color="#F5F2EC" Offset="0.5"/></LinearGradientBrush></Rectangle.Fill></Rectangle></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Sandstone" Tag="sandstone" IsCheckable="True" Click="TitleMenu_SetColor_Click">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Stroke="#A08055" StrokeThickness="1"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#DDC8A8" Offset="0.5"/><GradientStop Color="#F3EADC" Offset="0.5"/></LinearGradientBrush></Rectangle.Fill></Rectangle></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Sage" Tag="sage" IsCheckable="True" Click="TitleMenu_SetColor_Click">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Stroke="#7B9680" StrokeThickness="1"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#C5D5C6" Offset="0.5"/><GradientStop Color="#E7EEE7" Offset="0.5"/></LinearGradientBrush></Rectangle.Fill></Rectangle></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Ocean" Tag="ocean" IsCheckable="True" Click="TitleMenu_SetColor_Click">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Stroke="#6E91A4" StrokeThickness="1"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#B9D1DE" Offset="0.5"/><GradientStop Color="#E5EFF4" Offset="0.5"/></LinearGradientBrush></Rectangle.Fill></Rectangle></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Lavender" Tag="lavender" IsCheckable="True" Click="TitleMenu_SetColor_Click">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Stroke="#8E7BA5" StrokeThickness="1"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#D3C8E0" Offset="0.5"/><GradientStop Color="#EFEBF5" Offset="0.5"/></LinearGradientBrush></Rectangle.Fill></Rectangle></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Rose" Tag="rose" IsCheckable="True" Click="TitleMenu_SetColor_Click">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Stroke="#A67B84" StrokeThickness="1"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#DFC4C8" Offset="0.5"/><GradientStop Color="#F4E8E9" Offset="0.5"/></LinearGradientBrush></Rectangle.Fill></Rectangle></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Midnight" Tag="midnight" IsCheckable="True" Click="TitleMenu_SetColor_Click">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Stroke="#496B91" StrokeThickness="1"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1D3555" Offset="0.5"/><GradientStop Color="#131B29" Offset="0.5"/></LinearGradientBrush></Rectangle.Fill></Rectangle></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Graphite" Tag="graphite" IsCheckable="True" Click="TitleMenu_SetColor_Click">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Stroke="#58616E" StrokeThickness="1"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#292E36" Offset="0.5"/><GradientStop Color="#181B20" Offset="0.5"/></LinearGradientBrush></Rectangle.Fill></Rectangle></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Apply current theme to all Pickets" Click="TitleMenu_ApplyColorToAll_Click"/>
                </MenuItem>
                <MenuItem Header="Transparency" Tag="TransparencyMenu">
                <MenuItem Header="Solid (100%)" Tag="solid"  IsCheckable="True" Click="TitleMenu_SetTransparency_Click"/>
                <MenuItem Header="Light (65%)"  Tag="light"  IsCheckable="True" Click="TitleMenu_SetTransparency_Click"/>
                <MenuItem Header="Medium (40%)" Tag="medium" IsCheckable="True" Click="TitleMenu_SetTransparency_Click"/>
                <MenuItem Header="Heavy (20%)"  Tag="heavy"  IsCheckable="True" Click="TitleMenu_SetTransparency_Click"/>
                <Separator/>
                <MenuItem Tag="custom" StaysOpenOnClick="True" IsCheckable="True">
                    <MenuItem.Header>
                        <StackPanel Orientation="Vertical" Width="200" Margin="0,2">
                            <TextBlock Tag="CustomLabel" Text="Custom: 50%" Margin="0,0,0,2"/>
                            <Slider Tag="CustomSlider"
                                    Minimum="0" Maximum="100" Value="50"
                                    Width="190" TickFrequency="5"
                                    ValueChanged="TransparencyCustomSlider_ValueChanged"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                </MenuItem>
                <MenuItem Header="Blur background" Tag="BlurToggle" IsCheckable="True" Click="TitleMenu_ToggleBlur_Click"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Add section label..." Click="TitleMenu_AddLabel_Click"/>
            <MenuItem Header="New picket here" Click="TitleMenu_NewPicket_Click"/>
            <MenuItem Header="Delete this picket" Click="TitleMenu_DeletePicket_Click"/>
            <MenuItem Header="Settings">
                <MenuItem Header="Clean up missing items" Click="TitleMenu_CleanMissing_Click"/>
                <Separator/>
                <MenuItem Header="Hide / show all pickets (Ctrl+Alt+D)" Click="TitleMenu_HideAll_Click"/>
                <MenuItem Header="Launch at login" Tag="LaunchAtLogin" IsCheckable="True" Click="TitleMenu_ToggleLaunchAtLogin_Click"/>
                <Separator/>
                <MenuItem Header="Restore all icons and quit" Click="TitleMenu_RestoreAll_Click"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Quit Pickets" Click="TitleMenu_Quit_Click"/>
        </ContextMenu>

        <!-- Tooltips need a solid background; default semi-transparent styling over a blurred picket
             becomes unreadable against wallpaper. Dark pill + light text works on any color scheme. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#F01E1E1E"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="OuterShell"
                CornerRadius="10"
                Background="#C8EDEDED"
                BorderBrush="#70999999"
                BorderThickness="1">
            <DockPanel LastChildFill="True">
                <Border x:Name="TitleShell"
                        DockPanel.Dock="Top"
                        Background="#D0DDDDDD"
                        Height="30"
                        CornerRadius="10,10,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        ContextMenu="{StaticResource TitleContextMenu}"
                        ContextMenuOpening="TitleBar_ContextMenuOpening">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TitleText"
                                   Grid.Column="0"
                                   Text="Picket"
                                   Foreground="#2C2C2C"
                                   VerticalAlignment="Center"
                                   Margin="12,0,4,0"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="1"
                                                  Color="{DynamicResource PicketTitleShadowColor}"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBox x:Name="TitleEditBox"
                                 Grid.Column="0"
                                 Visibility="Collapsed"
                                 VerticalAlignment="Center"
                                 Margin="10,1,4,1"
                                 Background="{DynamicResource PicketEditorBackground}"
                                 Foreground="#2C2C2C"
                                 BorderBrush="{DynamicResource PicketEditorBorder}"
                                 FontSize="14"
                                 KeyDown="TitleEditBox_KeyDown"
                                 LostFocus="TitleEditBox_LostFocus"/>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0">
                            <Border x:Name="UnlinkBtn"
                                    Width="22" Height="22"
                                    Margin="0,0,2,0"
                                    VerticalAlignment="Center"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    ToolTip="Unlink from neighbors"
                                    Visibility="Collapsed"
                                    MouseLeftButtonDown="UnlinkBtn_MouseLeftButtonDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PicketControlHoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="&#xE71B;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{DynamicResource PicketTitleForeground}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="12">
                                    <TextBlock.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="1"
                                                          Color="{DynamicResource PicketTitleShadowColor}"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Border>
                            <Border x:Name="AddPicketBtn"
                                    Width="22" Height="22"
                                    VerticalAlignment="Center"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    ToolTip="New picket"
                                    MouseLeftButtonDown="AddPicketBtn_MouseLeftButtonDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PicketControlHoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="+"
                                           Foreground="{DynamicResource PicketTitleForeground}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="0,-2,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="1"
                                                          Color="{DynamicResource PicketTitleShadowColor}"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer x:Name="BodyScroll"
                              VerticalScrollBarVisibility="Auto"
                              AllowDrop="True"
                              Drop="ItemsHost_Drop"
                              DragOver="ItemsHost_DragOver"
                              Background="Transparent"
                              MouseLeftButtonDown="BodyScroll_MouseLeftButtonDown">
                    <ItemsControl x:Name="ItemsHost" Margin="6">
                        <ItemsControl.Resources>
                            <DataTemplate x:Key="FileItemTemplate">
                                <Border Width="{Binding CellWidth}"
                                        Height="{Binding CellHeight}"
                                        Margin="2"
                                        Padding="4"
                                        CornerRadius="4"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Opacity="{Binding CellOpacity}"
                                        MouseLeftButtonDown="Item_MouseDown"
                                        MouseMove="Item_MouseMove"
                                        MouseLeftButtonUp="Item_MouseLeftButtonUp"
                                        ContextMenu="{StaticResource ItemContextMenu}"
                                        ContextMenuOpening="Item_ContextMenuOpening"
                                        ToolTip="{Binding Path}">
                                    <Border.Style>
                                        <!-- Base: fully transparent. Hover follows the theme's contrast color,
                                             so it lightens dark schemes and darkens light schemes. Selection uses a translucent
                                             accent fill + matching border so the wallpaper/picket color still
                                             shows through the highlight. -->
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PicketItemHoverBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PicketSelectionBackground}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PicketSelectionBorder}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}"
                                               Width="{Binding IconSize}" Height="{Binding IconSize}"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,4"/>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource PicketItemForeground}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   FontSize="11"
                                                   MaxHeight="32"
                                                   TextTrimming="CharacterEllipsis">
                                            <!-- Soft halo behind the label so it stays readable on any wallpaper,
                                                 even when the picket body fades toward the desktop behind it. -->
                                            <TextBlock.Effect>
                                                <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="1"
                                                                  Color="{DynamicResource PicketItemShadowColor}"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate x:Key="LabelItemTemplate">
                                <!-- Width bound to the WrapPanel's ActualWidth so the label fills its row;
                                     WrapPanel then auto-breaks lines before and after it. -->
                                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=WrapPanel}}"
                                        Margin="0,8,0,4"
                                        Padding="6,2"
                                        Background="{DynamicResource PicketSectionBackground}"
                                        CornerRadius="3"
                                        Cursor="Hand"
                                        ContextMenu="{StaticResource LabelContextMenu}">
                                    <TextBlock Text="{Binding LabelText}"
                                               Foreground="{DynamicResource PicketItemForeground}"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Effect>
                                            <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="1"
                                                              Color="{DynamicResource PicketItemShadowColor}"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                            <local:PicketItemTemplateSelector x:Key="ItemSelector"
                                                             FileTemplate="{StaticResource FileItemTemplate}"
                                                             LabelTemplate="{StaticResource LabelItemTemplate}"/>
                        </ItemsControl.Resources>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplateSelector>
                            <StaticResource ResourceKey="ItemSelector"/>
                        </ItemsControl.ItemTemplateSelector>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Invisible resize thumbs (Opacity=0 keeps them hit-testable). -->
        <Thumb x:Name="ResizeRight"
               HorizontalAlignment="Right" VerticalAlignment="Stretch"
               Width="6" Cursor="SizeWE" Opacity="0"
               DragStarted="Resize_DragStarted" DragCompleted="Resize_DragCompleted"
               DragDelta="ResizeRight_DragDelta"/>
        <Thumb x:Name="ResizeBottom"
               HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
               Height="6" Cursor="SizeNS" Opacity="0"
               DragStarted="Resize_DragStarted" DragCompleted="Resize_DragCompleted"
               DragDelta="ResizeBottom_DragDelta"/>
        <Thumb x:Name="ResizeBottomRight"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Width="14" Height="14" Cursor="SizeNWSE" Opacity="0"
               DragStarted="Resize_DragStarted" DragCompleted="Resize_DragCompleted"
               DragDelta="ResizeBottomRight_DragDelta"/>
    </Grid>
</Window>
