<local:AccessibleDialogWindow x:Class="Pickets.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pickets"
        Title="Welcome to Pickets"
        Width="590" Height="610"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{DynamicResource DialogBackground}"
        Foreground="{DynamicResource DialogForeground}"
        FontFamily="Segoe UI">


    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="OnboardingContent" Grid.Row="0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,0">
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Welcome to Pickets" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource DialogMuted}" FontSize="14" TextWrapping="Wrap"
                       Text="Your desktop, organized without moving your files."/>
        </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="1   Ready your desktop"
                           VerticalAlignment="Center"/>
                <ToggleButton x:Name="DesktopHelpButton"
                              Margin="8,0,0,0" Width="22" Height="22"
                              Padding="0" Content="?" FontSize="13" FontWeight="Bold"
                              Background="{DynamicResource DialogSurface}" Foreground="{DynamicResource DialogForeground}"
                              BorderBrush="{DynamicResource DialogBorder}" BorderThickness="1"
                              Cursor="Hand" ToolTip="Why are these settings required?"
                              AutomationProperties.Name="Why desktop settings are required"/>
            </StackPanel>
            <Popup IsOpen="{Binding IsChecked, ElementName=DesktopHelpButton, Mode=TwoWay}"
                   PlacementTarget="{Binding ElementName=DesktopHelpButton}"
                   Placement="Bottom" HorizontalOffset="6" VerticalOffset="4"
                   AllowsTransparency="True" PopupAnimation="None" StaysOpen="False">
                <Border Width="410" MaxWidth="{Binding ActualWidth, ElementName=OnboardingContent}" Padding="15" CornerRadius="7"
                        Background="{DynamicResource DialogSurface}" BorderBrush="{DynamicResource DialogBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Why Pickets needs this" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DialogForeground}"/>
                        <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DialogMuted}"
                                   Text="Pickets keeps your files in place. It remembers each captured desktop icon's exact position, hides that icon, and shows it inside a picket instead."/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DialogMuted}"
                                   Text="Auto arrange and Align icons to grid let Windows reposition icons on its own. That can make captured icons reappear, jump, or lose their original spots. Turning both off lets Pickets restore everything exactly where it started."/>
                    </StackPanel>
                </Border>
            </Popup>
            <TextBlock Margin="28,3,0,8" Foreground="{DynamicResource DialogMuted}" TextWrapping="Wrap"
                       Text="Right-click the desktop, open View, and turn both options off. Pickets will check them for you."/>
            <StackPanel Margin="28,0,0,0">
                <Border Margin="0,0,0,6" Padding="10,7" CornerRadius="5" Background="{DynamicResource DialogSurface}">
                    <DockPanel>
                        <Ellipse x:Name="AutoArrangeIndicator" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AutoArrangeStatus" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Border Margin="0,0,0,6" Padding="10,7" CornerRadius="5" Background="{DynamicResource DialogSurface}">
                    <DockPanel>
                        <Ellipse x:Name="SnapToGridIndicator" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SnapToGridStatus" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Button Content="Check again" HorizontalAlignment="Left" Padding="12,6" Click="Recheck_Click"/>
                <TextBlock x:Name="ReadinessHint" Margin="0,8,0,0" Foreground="{DynamicResource DialogMuted}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>

            <TextBlock Margin="0,20,0,0" FontSize="16" FontWeight="SemiBold" Text="2   Keep Pickets handy"/>
            <StackPanel Margin="28,3,0,0">
                <CheckBox x:Name="CreateShortcutCheck"><TextBlock Text="Create a Pickets shortcut on my desktop" TextWrapping="Wrap"/></CheckBox>
                <CheckBox x:Name="RunAtLoginCheck"><TextBlock Text="Start Pickets when I sign in" TextWrapping="Wrap"/></CheckBox>
                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource DialogMuted}" FontSize="12" TextWrapping="Wrap"
                           Text="Tip: keep Pickets.exe in a permanent folder before enabling these options."/>
            </StackPanel>

            <TextBlock Margin="0,20,0,0" FontSize="16" FontWeight="SemiBold" Text="3   Start with one picket"/>
            <StackPanel Margin="28,3,0,0">
                <TextBlock Foreground="{DynamicResource DialogMuted}" Text="Use Add files or Add folders in an empty picket, or ⋯ → Add… anytime. Your original files stay where they are." TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource DialogMuted}" Text="Drop desktop icons inside an open section, below its title. Their desktop icons are hidden while captured. Drag items between open sections to organize them." TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource DialogMuted}" Text="Click a title to roll it up; drag the title to move the group." TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource DialogMuted}" Text="Ctrl+Alt+D focuses Pickets by default; press again while focused to hide. Change the shortcut or open keyboard help from the tray." TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource DialogMuted}" Text="Delete removes a reference, never the file. Drag a captured icon back to the desktop to return it. Ctrl+Z undoes supported organizing actions; Ctrl+F finds references." TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource DialogMuted}" Text="Tray → Quit Pickets restores captured desktop icons until your next launch. Alt+F4 only hides Pickets." TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource DialogMuted}" TextWrapping="Wrap"
                       Text="Reopen this guide anytime from the tray menu."/>
            <Button x:Name="GetStartedButton" HorizontalAlignment="Right" Content="Start using Pickets" IsDefault="True" IsEnabled="False" Click="GetStarted_Click"/>
        </StackPanel>
    </Grid>
</local:AccessibleDialogWindow>
