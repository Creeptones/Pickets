<Window x:Class="Pickets.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Pickets"
        Width="560" Height="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FF17191D"
        Foreground="#FFF4F5F7"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2E759C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF589BD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Welcome to Pickets" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Margin="0,6,0,0" Foreground="#FFAFB7C2" FontSize="14"
                       Text="Your desktop, organized without moving your files."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,28,0,0">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="1   Add icons"/>
            <TextBlock Margin="28,3,0,15" Foreground="#FFD1D6DD" TextWrapping="Wrap"
                       Text="Drag desktop icons into a picket, or hold Shift and right-drag a rectangle on the desktop."/>

            <TextBlock FontSize="16" FontWeight="SemiBold" Text="2   Open, move, and resize"/>
            <TextBlock Margin="28,3,0,15" Foreground="#FFD1D6DD" TextWrapping="Wrap"
                       Text="Click a title to roll a picket up or down. Drag the title to move it and drag an edge to resize it."/>

            <TextBlock FontSize="16" FontWeight="SemiBold" Text="3   Return icons"/>
            <TextBlock Margin="28,3,0,15" Foreground="#FFD1D6DD" TextWrapping="Wrap"
                       Text="Drag an icon back onto the desktop, or right-click it and choose Remove from picket."/>

            <TextBlock FontSize="16" FontWeight="SemiBold" Text="4   Stay in control"/>
            <TextBlock Margin="28,3,0,0" Foreground="#FFD1D6DD" TextWrapping="Wrap"
                       Text="Use Ctrl+Alt+D or the tray icon to show and hide everything. Normal Quit restores desktop icons until your next launch."/>
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,24,0,0">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#FF8F99A6"
                       Text="Right-click any picket title for settings."/>
            <Button DockPanel.Dock="Right" Content="Get started" IsDefault="True" Click="GetStarted_Click"/>
        </DockPanel>
    </Grid>
</Window>
