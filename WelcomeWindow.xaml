<Window x:Class="Pickets.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Pickets"
        Width="590" Height="610"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FF17191D"
        Foreground="#FFF4F5F7"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2E759C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF589BD5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF4F5F7"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Welcome to Pickets" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Margin="0,6,0,0" Foreground="#FFAFB7C2" FontSize="14"
                       Text="Your desktop, organized without moving your files."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="1   Ready your desktop"
                           VerticalAlignment="Center"/>
                <ToggleButton x:Name="DesktopHelpButton"
                              Margin="8,0,0,0" Width="22" Height="22"
                              Padding="0" Content="?" FontSize="13" FontWeight="Bold"
                              Background="#FF24282E" Foreground="#FFD8E5EE"
                              BorderBrush="#FF53616D" BorderThickness="1"
                              Cursor="Hand" ToolTip="Why are these settings required?"
                              AutomationProperties.Name="Why desktop settings are required"/>
            </StackPanel>
            <Popup IsOpen="{Binding IsChecked, ElementName=DesktopHelpButton, Mode=TwoWay}"
                   PlacementTarget="{Binding ElementName=DesktopHelpButton}"
                   Placement="Bottom" HorizontalOffset="6" VerticalOffset="4"
                   AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
                <Border Width="410" Padding="15" CornerRadius="7"
                        Background="#FF24282E" BorderBrush="#FF53616D" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Why Pickets needs this" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#FFF4F5F7"/>
                        <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#FFD1D6DD"
                                   Text="Pickets keeps your files in place. It remembers each captured desktop icon's exact position, hides that icon, and shows it inside a picket instead."/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FFD1D6DD"
                                   Text="Auto arrange and Align icons to grid let Windows reposition icons on its own. That can make captured icons reappear, jump, or lose their original spots. Turning both off lets Pickets restore everything exactly where it started."/>
                    </StackPanel>
                </Border>
            </Popup>
            <TextBlock Margin="28,3,0,8" Foreground="#FFD1D6DD" TextWrapping="Wrap"
                       Text="Right-click the desktop, open View, and turn both options off. Pickets will check them for you."/>
            <Grid Margin="28,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,8,0" Padding="10,7" CornerRadius="5" Background="#FF24282E">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="AutoArrangeIndicator" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AutoArrangeStatus" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="0,0,8,0" Padding="10,7" CornerRadius="5" Background="#FF24282E">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SnapToGridIndicator" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SnapToGridStatus" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button Grid.Column="2" Content="Check again" Padding="12,6" Click="Recheck_Click"/>
            </Grid>

            <TextBlock Margin="0,20,0,0" FontSize="16" FontWeight="SemiBold" Text="2   Keep Pickets handy"/>
            <StackPanel Margin="28,3,0,0">
                <CheckBox x:Name="CreateShortcutCheck" Content="Create a Pickets shortcut on my desktop"/>
                <CheckBox x:Name="RunAtLoginCheck" Content="Start Pickets when I sign in"/>
                <TextBlock Margin="0,6,0,0" Foreground="#FF8F99A6" FontSize="12" TextWrapping="Wrap"
                           Text="Tip: keep Pickets.exe in a permanent folder before enabling these options."/>
            </StackPanel>

            <TextBlock Margin="0,20,0,0" FontSize="16" FontWeight="SemiBold" Text="3   Three useful moves"/>
            <StackPanel Margin="28,3,0,0">
                <TextBlock Foreground="#FFD1D6DD" Text="Drag desktop icons into a picket to organize them."/>
                <TextBlock Margin="0,4,0,0" Foreground="#FFD1D6DD" Text="Click a title to roll it up; drag the title to move the group."/>
                <TextBlock Margin="0,4,0,0" Foreground="#FFD1D6DD" Text="Press Ctrl+Alt+D to show or hide every picket."/>
            </StackPanel>
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#FF8F99A6"
                       Text="Reopen this guide anytime from the tray menu."/>
            <Button DockPanel.Dock="Right" Content="Start using Pickets" IsDefault="True" Click="GetStarted_Click"/>
        </DockPanel>
    </Grid>
</Window>
