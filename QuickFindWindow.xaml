<local:AccessibleDialogWindow x:Class="Pickets.QuickFindWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pickets" Title="Find a reference — Pickets"
        Width="620" Height="440" WindowStartupLocation="CenterScreen" PreviewKeyDown="Search_KeyDown">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="Find across all pickets" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBox x:Name="Query" DockPanel.Dock="Top" TextChanged="Query_Changed" Margin="0,0,0,10" Padding="8"
                 AutomationProperties.Name="Search reference names, paths, and picket names"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="GoButton" Content="Go to reference" DockPanel.Dock="Right" Click="Go_Click" Padding="12,6" IsEnabled="False"/>
            <TextBlock x:Name="SearchStatus" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                       AutomationProperties.LiveSetting="Polite" Text="Type a name to find a reference."/>
        </DockPanel>
        <ListBox x:Name="Results" AutomationProperties.Name="Matching references" MouseDoubleClick="Result_DoubleClick"
                 SelectionChanged="Results_SelectionChanged" Background="{DynamicResource DialogSurface}"
                 Foreground="{DynamicResource DialogForeground}" BorderBrush="{DynamicResource DialogBorder}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5" ToolTip="{Binding Path}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Location}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</local:AccessibleDialogWindow>
